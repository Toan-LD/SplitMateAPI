<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title</title>
</head>
<body>
    <div class="email-container">
        <div class="email-header">
            <h1>@ViewBag.CompanyName</h1>
        </div>

        <div class="email-body">
            @RenderBody()
        </div>

        <div class="email-footer">
            <p class="text-muted">
                © @DateTime.Now.Year @ViewBag.CompanyName. Tất cả quyền được bảo lưu.<br>
                Nếu bạn không muốn nhận email này nữa,
                <a href="#" style="color: #667eea;">hủy đăng ký tại đây</a>.
            </p>
        </div>
    </div>
</body>
</html>